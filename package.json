{
  "name": "context-template",
  "version": "0.0.1",
  "description": "Context template repository.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "contexts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/interop-alliance/context-template"
  },
  "bugs": {
    "url": "https://github.com/interop-alliance/context-template/issues"
  },
  "author": {
    "name": "Digital Bazaar, Inc.",
    "email": "support@digitalbazaar.com",
    "url": "https://digitalbazaar.com/"
  },
  "homepage": "https://github.com/interop-alliance/context-template#readme",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "pnpm run clear && tsc && pnpm run serialize",
    "clear": "rimraf dist/* contexts/*.jsonld",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.js\" \"*.md\"",
    "lint": "eslint src test",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "serialize": "node bin/serialize.js",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "pnpm run fix && pnpm run lint && pnpm run typecheck && pnpm run test:node && pnpm run test:browser",
    "test:browser": "playwright test",
    "test:node": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0"
  }
}
